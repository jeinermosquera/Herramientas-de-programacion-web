{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "src": "/css/(.*)", "headers": { "cache-control": "public, max-age=31536000, immutable" } },
    { "src": "/js/(.*)", "headers": { "cache-control": "public, max-age=31536000, immutable" } },
    { "src": "/img/(.*)", "headers": { "cache-control": "public, max-age=31536000, immutable" } },
    { "src": "/data/(.*)", "headers": { "cache-control": "public, max-age=3600" } },
    { "src": "/favicon(.*)", "headers": { "cache-control": "public, max-age=31536000, immutable" } }
  ]
}
